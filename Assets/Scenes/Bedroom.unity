  m_Script: {fileID: 11500000, guid: f58c291b91ab4a247943dcf9d813c8cf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PhotoGalleryController
  contentArea: {fileID: 1575271973}
  photoViewerPanel: {fileID: 1502827424}
  enlargedPhoto: {fileID: 788038464}
  photo1Sprite: {fileID: -4215248698715248153, guid: 940994bfc2ff6ef4cb1e29a6f3439a50, type: 3}
  photo1Dialogues:
  - Lucia and I used to be together all the time.
  - ...Things felt simpler back then.
  photo2Sprite: {fileID: -513879639, guid: 940994bfc2ff6ef4cb1e29a6f3439a50, type: 3}
  photo2Dialogues:
  - Lucia always loved the swings.
  - She used to laugh at the smallest things.
  photo3Sprite: {fileID: 1933925682, guid: 940994bfc2ff6ef4cb1e29a6f3439a50, type: 3}
  photo3Dialogues:
  - She was so excited that day.
  - I remember wishing things could stay like this.
  photo4Sprite: {fileID: -1351428166, guid: 940994bfc2ff6ef4cb1e29a6f3439a50, type: 3}
  photo4Dialogues:
  - Lucia always asked me for help with her homework.
  - ...Even when she already knew the answer.
  photo5Sprite: {fileID: 1250414165, guid: 940994bfc2ff6ef4cb1e29a6f3439a50, type: 3}
  photo5Dialogues:
  - She used to fall asleep beside me all the time.
  - I never thought those nights would feel so far away.
  photo6Sprite: {fileID: -987660330, guid: 940994bfc2ff6ef4cb1e29a6f3439a50, type: 3}
  photo6Dialogues:
  - We promised we'd watch the sunset together again someday.
  - ...I wonder if she still remembers.
